" Tab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set autoindent

" Number
set number
set numberwidth=1

" Tilde
set fillchars=eob:\ 
set shortmess=IfilnxtToOS

" Disable cache
set viminfo=
set noswapfile

" Disable color
syntax off
hi Normal ctermfg=none ctermbg=none
hi LineNr ctermfg=none ctermbg=none
hi WildMenu ctermfg=none ctermbg=none
hi StatusLine ctermfg=none ctermbg=none
