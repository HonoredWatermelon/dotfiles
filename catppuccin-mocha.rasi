/* Catppuccin Mocha Palette */
* {
    bg:      #1e1e2e;
    bg-alt:  #181825;
    fg:      #cdd6f4;
    fg-dim:  #a6adc8;
    accent:  #cba6f7;
    sel-bg:  #cdd6f4;
    sel-fg:  #1e1e2e;

    font: "Roboto 16";
}

configuration {
    show-icons: false;
    disable-history: true;
    max-history: 0;
    drun-display-format: "{name}";
}

window {
    width: 45%;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @fg;
    border-radius: 12px;
    background-color: @bg;
    padding: 12px;
}

mainbox {
    children: [ listview ];
    spacing: 0;
    background-color: transparent;
}

listview {
    lines: 6;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
    background-color: transparent;
    fixed-height: false;
    dynamic: false;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    background-color: @bg-alt;
    text-color: @fg;
    border: 1px;
    border-color: @bg-alt;
}

element selected {
    background-color: @sel-bg;
    text-color: @sel-fg;
    border: 2px;
    border-color: @fg;
    border-radius: 8px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "Roboto 16";
    vertical-align: 0.5;
}

element-icon {
    background-color: transparent;
    size: 1.2em;
}
